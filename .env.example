# Copy to .env and adjust. Every value has a sensible default; with none set the
# app runs on SQLite + in-memory cache.

# Public origin used in generated links
BASE_URL=http://localhost:8000

# SQLite (local) or Postgres (production). postgres:// URLs are normalised automatically.
DATABASE_URL=sqlite+aiosqlite:///./shortener.db
# DATABASE_URL=postgresql+asyncpg://shortener:shortener@localhost:5432/shortener

# Leave empty to use the in-memory cache
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# base62 (Snowflake ID -> base62) | hash (hash + collision resolution)
SHORTENER_STRATEGY=base62
HASH_CODE_LENGTH=7

# 301 permanent (less load) | 302 temporary (accurate click analytics)
REDIRECT_STATUS_CODE=302
TRACK_CLICKS=true

CACHE_TTL_SECONDS=86400
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Snowflake worker identity: "auto" (lease from Redis) or 0..31
DATACENTER_ID=0
MACHINE_ID=auto

LOG_LEVEL=INFO
